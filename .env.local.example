NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Monday email (all server-side; never commit real values)
RESEND_API_KEY=
# Sender shown on the digest. Defaults to "Command Center <kcc@kacof.tech>".
DIGEST_FROM=
# Random string; a scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Public address of the app, used for links inside the email.
APP_URL=
# Owner's timezone so "today" is right, e.g. Asia/Kathmandu.
APP_TIMEZONE=
